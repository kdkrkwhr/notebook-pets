{
  "name": "notebuddy-anna",
  "version": "1.4.18",
  "private": true,
  "description": "Notebook Pets on Anna: one lifelong AI companion.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs --slug notebuddy-dev --storage aps --llm-account https://anna.partners",
    "validate": "anna-app validate --strict",
    "test": "node --test tests/*.test.mjs",
    "prepare:assets": "python -B -X utf8 scripts/prepare_assets.py",
    "test:plugin": "uv run --project executas/notebuddy python -B -X utf8 -m unittest discover -s tests -p test_*.py -v",
    "test:browser": "node --test --test-concurrency=2 tests/browser/*.browser.mjs"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.57",
    "playwright-core": "1.64.0"
  }
}
