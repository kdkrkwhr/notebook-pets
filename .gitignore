# 유저 상태 파일 (게임 SoT — 유저별 세이브)
state/*.json
state/.store.lock
state/.notebook-*.tmp
data/.notebook-*.tmp
artwork/
delivery/
.gateway/
backups/
albums/
!state/.gitkeep

# 소유주 등록 (런타임 접근 제어 — 배포마다 다름)
data/access.json

# 생성 로그 (이미지 PNG 자체는 게임 에셋으로 커밋)
assets/prerender_log.json
assets/**/*.job.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# 가상환경 / 시크릿
.venv/
venv/
.env
.env.*
notebook.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
